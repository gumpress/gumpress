{
	"folders": [
		@FOLDERS@ // Path relative to this file or absolute
	],
	"settings": {
		"editor.tabSize": 4,
		"editor.insertSpaces": false,
		"git.openRepositoryInParentFolders": "never",
		"git.autofetch": null,
		"php.validate.executablePath": @PHP-PATHNAME@,
		"php.executablePath": @PHP-PATHNAME@,
		"files.exclude": {
			"gitraw_data": true,
			"stored_data": true,
			"@manifest.json": true
		},
		"files.associations": {
			"*.module": "php"
		},
		"rest-client.defaultHeaders": {
			"X-GumPress-Auth": @X-GUMPRESS-AUTH@
		},
		"terminal.integrated.profiles.windows": {
			"Git Bash": null
		},
		"terminal.integrated.shellIntegration.enabled": false
	},
	"extensions": {
		"recommendations": [
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "WordPress  ",
				"type": "php",
				"request": "launch",
				"port": @XDEBUG-PORT@,
			// "maxConnections": 1,
				"log": false
			}
		]
	}
}

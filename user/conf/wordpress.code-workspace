{
	"folders": [
		@FOLDERS@ // Path relative to this file or absolute
	],
	"settings": {
		"editor.tabSize": 4,
		"editor.insertSpaces": false,
		"git.openRepositoryInParentFolders": "never",
		"git.autofetch": false,
		"php.validate.executablePath": @PHP-PATHNAME@,
		"php.executablePath": @PHP-PATHNAME@,

		"workbench.startupEditor": "none",
		"workbench.colorTheme": "Default Dark Modern",
		"search.quickOpen.includeHistory": false,
		"npm.fetchOnlinePackageInfo": false,

		"files.exclude": {
			"gitraw_data": true,
			"stored_data": true,
			"stored_data/mariadb": true,
			"@manifest.json": true
		},
		"files.associations": {
			"*.module": "php"
		},
		"rest-client.defaultHeaders": {
			"X-GumPress-Auth": @X-GUMPRESS-AUTH@
		},
		"terminal.integrated.defaultProfile.windows": "Git Bash",
		"terminal.integrated.cwd": @CWD@,
		"terminal.integrated.shellIntegration.enabled": true,
		"terminal.integrated.profiles.windows": {
			"PowerShell": null
		},
	},
	"extensions": {
		"recommendations": [
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "WordPress",
				"type": "php",
				"request": "launch",
				"port": @XDEBUG-PORT@,
				"hostname": "localhost"
			// "maxConnections": 1,
				"log": false
			}
		]
	}
}
